# Flask基础配置
FLASK_DEBUG=1
FLASK_ENV=development

# 服务配置
SERVICE_IP=
SERVICE_API_PREFIX=

# Github OAuth应用秘钥
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/auth/authorize/github


# jwt加密秘钥
JWT_SECRET_KEY=

# SQLAlchemy数据库配置
SQLALCHEMY_DATABASE_URI=postgresql://postgres:postgres@localhost:5432/llmops?client_encoding=utf8
SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=True

# 辅助Agent智能体应用id标识
ASSISTANT_AGENT_ID=6774fcef-b594-8008-b30c-a05b8190afe6

# Redis数据库配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_USE_SSL=False

# Celery配置
CELERY_BROKER_DB=1
CELERY_RESULT_BACKEND_DB=1
CELERY_TASK_IGNORE_RESULT=False
CELERY_RESULT_EXPIRES=3600
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True

# OpenAI开放API平台
OPENAI_API_KEY=
OPENAI_API_BASE=

# DeepSeek开放API平台
DEEPSEEK_API_KEY=

# 月之暗面开放API平台
MOONSHOT_API_KEY=

# 智谱开放API平台
ZHIPU_API_KEY=

# LangSmith配置
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="LLMOpsDev"

# Weaviate向量数据库配置
WEAVIATE_HTTP_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_HOST=localhost
WEAVIATE_GRPC_PORT=50051


# 高德工具
GAODE_API_KEY=

# 谷歌Serper搜索
SERPER_API_KEY=

# 腾讯云COS对象存储
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_SCHEME=https
COS_BUCKET=
COS_DOMAIN=

# wtf配置
WTF_CSRF_ENABLED=False

# 设置huggingface强制离线
HF_HUB_OFFLINE=1
