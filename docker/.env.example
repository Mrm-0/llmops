# ===== 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会被提交） =====
# cp .env.example .env

# 服务地址：虚拟机的局域网 IP，查法：ip a
SERVICE_IP=192.168.2.100
SERVICE_API_PREFIX=http://192.168.2.100/api

# JWT 秘钥（随机 32 位字符串）
JWT_SECRET_KEY=

# 数据库 / Redis 密码
POSTGRES_PASSWORD=llmops123456
REDIS_PASSWORD=llmops123456

# Weaviate 鉴权秘钥
WEAVIATE_API_KEY=

# 腾讯云 COS 对象存储
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=

# GitHub OAuth 应用
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://192.168.2.100/api/auth/authorize/github

# LangSmith（不追踪就留空）
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=LLMOpsDev

# 辅助 Agent 智能体应用 id
ASSISTANT_AGENT_ID=

# 模型服务提供者（至少配一个，否则 Agent 功能不可用）
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
DEEPSEEK_API_KEY=
QIANFAN_AK=
QIANFAN_SK=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=

# 工具类 API
GAODE_API_KEY=
SERPER_API_KEY=
