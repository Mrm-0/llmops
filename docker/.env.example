# ===== 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会被提交） =====
# cp .env.example .env

# 服务地址：虚拟机的局域网 IP，查法：ip a
SERVICE_IP=
SERVICE_API_PREFIX=

# GitHub OAuth秘钥
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/auth/authorize/github

# jwt加密秘钥
JWT_SECRET_KEY=

# SQLAlchemy数据库配置
SQLALCHEMY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llmops
SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=True

# 辅助智能体会话ID
ASSISTANT_AGENT_ID=78e924b6-2174-41c8-9d30-5f27a061350d

# Redis数据库配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_USE_SSL=False

# Celery配置
CELERY_BROKER_DB=1
CELERY_RESULT_BACKEND_DB=1
CELERY_TASK_IGNORE_RESULT=False
CELERY_RESULT_EXPIRES=3600
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True

# OpenAI开放API平台
OPENAI_API_KEY=
OPENAI_API_BASE=

# DeepSeek开放API平台
DEEPSEEK_API_KEY=

# 月之暗面开放API平台
MOONSHOT_API_KEY=

# 智谱开放API平台
ZHIPU_API_KEY=

# LangSmith配置
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="LLMOpsDev"

# Weaviate向量数据库配置
WEAVIATE_HTTP_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_CRPC_HOST=localhost
WEAVIATE_CRPC_PORT=50051
WEAVIATE_API_KEY=

# 高德配置
GAODE_API_KEY=

# GoogleSerperRun配置
SERPER_API_KEY=

# 腾讯云COS对象存储
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_SCHEME=https
COS_BUCKET=
COS_DOMAIN=

# wtf配置
WTF_CSRF_ENABLED=False

# 设置huggingface强制离线
HF_HUB_OFFLINE=1
